{
  "name": "llmf",
  "version": "0.7.5",
  "description": "llmf (llmfree): one dead-simple call for free, keyless LLM endpoints, with automatic fallback.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "bin": {
    "llmf-js": "./bin/llmf-js.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "bin",
    "index.d.ts",
    "README.md",
    "README.vi.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "llm",
    "ai",
    "chat",
    "free",
    "keyless",
    "openai-compatible",
    "fallback",
    "termux"
  ],
  "author": "Html",
  "license": "MIT",
  "homepage": "https://github.com/MoonLite-Br/llmfree-js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoonLite-Br/llmfree-js.git"
  },
  "bugs": {
    "url": "https://github.com/MoonLite-Br/llmfree-js/issues"
  },
  "dependencies": {}
}
